# Copy to .env. IntelliJ defaults in application.yaml remain unchanged.
COMPOSE_PROJECT_NAME=orderflow
IMAGE_PREFIX=orderflow
IMAGE_TAG=local
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
# Keep this ID stable for an existing kafka_data volume.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
DISCOVERY_PORT=8761
GATEWAY_PORT=9000
ORDER_PORT=8081
INVENTORY_PORT=8082
GATEWAY_CONNECT_TIMEOUT_MS=1000
GATEWAY_RESPONSE_TIMEOUT=3s
GATEWAY_TOTAL_TIMEOUT=7s
GATEWAY_GET_MAX_ATTEMPTS=2
GATEWAY_CB_MIN_CALLS=10
GATEWAY_CB_OPEN_WAIT=10s
# Enable when the optional observability stack is running.
TRACING_ENABLED=false
ZIPKIN_ENDPOINT=http://host.docker.internal:9411/api/v2/spans
